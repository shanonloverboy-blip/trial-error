# Kode akses bersama yang dipakai seluruh tim untuk masuk (wajib diisi)
APP_PASSCODE=ganti-dengan-kode-rahasia-tim

# String acak untuk menandatangani sesi login (wajib diisi, bebas string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Diisi otomatis oleh Vercel setelah menambahkan integrasi "Vercel KV" (Storage tab di dashboard project)
KV_REST_API_URL=
KV_REST_API_TOKEN=
